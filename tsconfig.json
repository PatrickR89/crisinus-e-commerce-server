{
  "compilerOptions": {
    "target": "es2019",
    "module": "commonjs",
    "rootDir": ".",
    "outDir": "dist",
    "esModuleInterop": true,
    "strict": true,
    "allowJs": true
  },
  "include": [
    "src/**/*",
    "index.js",
    "controllers/**/*.js",
    "routes/**/*.js",
    "databaseMiddleware/**/*.js",
    "JWT/**/*.js",
    "utils/**/*.js"
  ]
}
